# Wedding Website Studio — environment variables
# Copy to .env.local and fill in real values. PLACEHOLDERS ONLY here —
# never commit real secrets to the repo.

# Supabase project URL (Supabase dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose in the browser; RLS applies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key — SECRET. Server-side only, bypasses RLS.
# Never put this in NEXT_PUBLIC_* or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Etsy API key for a future automatic order sync; the static-PDF delivery
# model works without it
ETSY_API_KEY=your-etsy-api-key

# Etsy shop ID the listings belong to
ETSY_SHOP_ID=your-etsy-shop-id

# Public base URL of this app (no trailing slash). Used for public guest
# URLs, QR codes and PDF links. In development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard password (demo default is "admin123" — change in production)
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign admin/customer session cookies (long random string)
SESSION_SECRET=change-me-to-a-long-random-string
